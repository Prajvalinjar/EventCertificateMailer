# Server Configuration
PORT=3001

# Resend Email API Configuration (Recommended for Render cloud deployment)
# Sign up and get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=Event Certificate Team

# Gmail SMTP Configuration Example (Alternative)
# IMPORTANT SECURITY NOTES:
# 1. Never commit real credentials to GitHub.
# 2. Never use your regular Google account password.
# 3. Generate a 16-character Google App Password:
#    Google Account -> Security -> 2-Step Verification -> App Passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-official-email@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM_NAME=Event Certificate Team

# Allowed Frontend Origins (CORS)
# If frontend and backend are deployed on different domains (e.g. Vercel frontend + Render backend):
# - Set to '*' to allow any frontend origin, OR
# - Specify your frontend URL(s) separated by commas (without trailing slashes):
#   Example: ALLOWED_ORIGIN=https://my-cert-mailer.vercel.app,http://localhost:3000
ALLOWED_ORIGIN=*

